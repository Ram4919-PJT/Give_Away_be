# =============================================================================
# IAM Service — environment configuration
# Copy to .env and update values:  cp .env.example .env
# =============================================================================

# --- Application ---
APP_NAME=IAM Service
ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=8001

# --- Database ---
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@localhost:5432/iam_db

# --- JWT ---
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me-generate-a-secure-random-secret-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- OTP ---
OTP_EXPIRE_MINUTES=10
OTP_MAX_PENDING=3
OTP_LOG_TO_CONSOLE=true

# --- CORS (comma-separated; no spaces required) ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8081,http://127.0.0.1:8081
