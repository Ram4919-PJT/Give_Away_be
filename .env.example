# Give Away API Gateway
# Copy to .env:  cp .env.example .env
#
# IAM secrets (DATABASE_URL, JWT_SECRET_KEY) live in:
#   services/iam-service/.env

GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000
GATEWAY_RELOAD=true

REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=true
REDIS_LOGIN_RATE_LIMIT=5
REDIS_LOGIN_RATE_WINDOW=900
REDIS_OTP_RATE_LIMIT=3
REDIS_OTP_RATE_WINDOW=600

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8081,http://127.0.0.1:8081
