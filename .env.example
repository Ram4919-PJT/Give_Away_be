# Give Away backend — environment variables (example)
# Copy to .env and fill in values. Never commit real secrets.

# --- Core Management Service ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/core_mgmt_db
JWT_SECRET_KEY=dev-secret-key-minimum-32-characters-long

# OpenStreetMap Nominatim (reverse/forward geocoding — no API key required)
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=GiveAway/1.0 (contact@giveaway.org)
NOMINATIM_MIN_INTERVAL_SEC=1.1
NOMINATIM_COUNTRY_CODES=in
GEOCODING_TIMEOUT_SEC=12.0

# Razorpay (payments — secret keys backend only)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_CURRENCY=INR
PAYMENT_DEV_MODE=true

# Super-admin user id for KYC / assistance notifications (IAM users.user_id)
ADMIN_NOTIFY_USER_ID=1

# Frontend URLs for notification deep links
USER_APP_URL=http://localhost:5173
ADMIN_PORTAL_URL=http://localhost:5174

# Receiver KYC
KYC_PROVIDER=MANUAL
ALLOW_MOCK_KYC=false
BANK_VERIFICATION_PROVIDER=MANUAL
KYC_HIGH_VALUE_THRESHOLD=100000
KYC_MEDIUM_VALUE_THRESHOLD=50000
KYC_MOBILE_OTP_EXPIRE_MINUTES=10
KYC_MOBILE_OTP_MAX_ATTEMPTS=5
KYC_MOBILE_OTP_RESEND_COOLDOWN_SEC=60

REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=true
REDIS_LOGIN_RATE_LIMIT=5
REDIS_LOGIN_RATE_WINDOW=900
REDIS_OTP_RATE_LIMIT=3
REDIS_OTP_RATE_WINDOW=600

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:8081,http://127.0.0.1:8081

# --- IAM Service ---
# IAM_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/iam_db

# --- Communication Service ---
# COMM_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/communication_db
