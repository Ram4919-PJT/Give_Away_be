# Give Away API Gateway
# Copy to .env:  cp .env.example .env
#
# IAM secrets (DATABASE_URL, JWT_SECRET_KEY) live in:
#   services/iam-service/.env

GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000
GATEWAY_RELOAD=true

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:8081,http://127.0.0.1:8081
